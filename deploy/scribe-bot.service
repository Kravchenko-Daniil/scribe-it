[Unit]
Description=Scribe It — Telegram transcription bot
After=network-online.target scribe-api.service
Wants=network-online.target scribe-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/scribe-bot
Environment=APP_ENV=prod
ExecStart=/root/.local/bin/uv run --project /opt/scribe-bot python bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
